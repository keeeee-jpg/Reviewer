  <!-- SYSTEM NOTIFICATION TOAST -->
  <div id="toast" class="fixed bottom-5 right-5 z-50 transform translate-y-20 opacity-0 transition-all duration-300 pointer-events-none">
    <div class="bg-industrial-800 border border-industrial-600 text-white px-4 py-3 rounded-xl shadow-2xl flex items-center gap-3 font-mono text-xs">
      <i id="toastIcon" class="fa-solid fa-circle-info text-industrial-accent"></i>
      <span id="toastMessage">Notification message</span>
    </div>
  </div>


  <!-- APPLICATION JAVASCRIPT LOGIC -->
  <script>
    // --- SAMPLE DEFAULT DEMO DATASET ---
    const DEMO_CARDS = [
      {
        word: "Mitochondria",
        meaning: "The powerhouse of the cell responsible for generating chemical energy (ATP) through cellular respiration.",
        category: "Biology",
        extra: "Characteristics: Double-membrane bound organelle, contains its own DNA independent of the nucleus."
      },
      {
        word: "Polymorphism",
        meaning: "The ability of an object or method in Object-Oriented Programming to take on multiple structural forms.",
        category: "Computer Science",
        extra: "Types: Compile-time (Method Overloading) vs Run-time (Method Overriding)."
      },
      {
        word: "Inflation",
        meaning: "The general increase in prices and fall in the purchasing value of money over a given period of time.",
        category: "Economics",
        extra: "Key Metrics: Consumer Price Index (CPI), Producer Price Index (PPI)."
      }
    ];

    // --- STATE MANAGEMENT VARIABLES ---
    let localCustomCards = JSON.parse(localStorage.getItem('reviewer_custom_cards') || '[]');
    let currentDeck = localCustomCards.length > 0 ? [...localCustomCards] : [...DEMO_CARDS];
    let currentIndex = 0;
    let isFlipped = false;
    let studyMode = 'term-first'; // 'term-first' or 'def-first'
    let sourceType = localCustomCards.length > 0 ? 'local' : 'demo'; 
    let scriptUrl = localStorage.getItem('reviewer_script_url') || '';
    
    // Stats tracking
    let masteredCount = 0;
    let needsReviewCount = 0;

    // --- INITIALIZATION ---
    window.onload = function () {
      if(scriptUrl) {
        document.getElementById('scriptUrlInput').value = scriptUrl;
      }
      
      document.addEventListener('keydown', handleKeyPress);
      
      if (localCustomCards.length > 0) {
        document.getElementById('sourceLabel').innerText = "My Saved Deck";
        document.getElementById('sourceIndicator').classList.remove('hidden');
      }

      renderCard();
      renderCustomCardsList();
    };

    // --- CARD MANAGER LOGIC (LOCAL STORAGE INPUT) ---
    function openCardManagerModal() {
      renderCustomCardsList();
      document.getElementById('cardManagerModal').classList.remove('hidden');
    }

    function closeCardManagerModal() {
      document.getElementById('cardManagerModal').classList.add('hidden');
    }

    function addCustomCard() {
      const word = document.getElementById('newWordInput').value.trim();
      const meaning = document.getElementById('newMeaningInput').value.trim();
      const category = document.getElementById('newCategoryInput').value.trim() || 'General';
      const extra = document.getElementById('newExtraInput').value.trim();

      if (!word || !meaning) {
        showToast("Please enter both a Term and a Meaning", "warning");
        return;
      }

      const newCard = { word, meaning, category, extra };
      localCustomCards.push(newCard);
      localStorage.setItem('reviewer_custom_cards', JSON.stringify(localCustomCards));

      // Clear input fields
      document.getElementById('newWordInput').value = '';
      document.getElementById('newMeaningInput').value = '';
      document.getElementById('newCategoryInput').value = '';
      document.getElementById('newExtraInput').value = '';

      // Switch current active deck to local custom deck
      currentDeck = [...localCustomCards];
      sourceType = 'local';
      document.getElementById('sourceLabel').innerText = "My Saved Deck";
      document.getElementById('sourceIndicator').classList.remove('hidden');

      renderCustomCardsList();
      renderCard();
      showToast("New card added and saved!", "success");
    }

    function deleteCustomCard(index) {
      localCustomCards.splice(index, 1);
      localStorage.setItem('reviewer_custom_cards', JSON.stringify(localCustomCards));
      
      if (localCustomCards.length > 0) {
        currentDeck = [...localCustomCards];
      } else {
        currentDeck = [...DEMO_CARDS];
        document.getElementById('sourceLabel').innerText = "Demo Deck";
      }
      
      if (currentIndex >= currentDeck.length) {
        currentIndex = Math.max(0, currentDeck.length - 1);
      }

      renderCustomCardsList();
      renderCard();
      showToast("Card deleted");
    }

    function clearCustomCards() {
      if (!confirm("Are you sure you want to delete all saved cards?")) return;
      localCustomCards = [];
      localStorage.removeItem('reviewer_custom_cards');
      currentDeck = [...DEMO_CARDS];
      currentIndex = 0;
      document.getElementById('sourceLabel').innerText = "Demo Deck";

      renderCustomCardsList();
      renderCard();
      showToast("All custom cards cleared. Resetting to Demo deck.");
    }

    function renderCustomCardsList() {
      const container = document.getElementById('customCardsList');
      document.getElementById('customCardCount').innerText = localCustomCards.length;

      if (localCustomCards.length === 0) {
        container.innerHTML = `<div class="text-center py-6 text-slate-500 text-xs italic">No custom cards added yet. Add your first card above!</div>`;
        return;
      }

      container.innerHTML = localCustomCards.map((card, idx) => `
        <div class="p-3 bg-industrial-900 rounded-lg border border-industrial-700/80 flex items-center justify-between gap-3 text-xs">
          <div class="overflow-hidden">
            <div class="flex items-center gap-2">
              <span class="font-bold text-white truncate">${escapeHtml(card.word)}</span>
              <span class="px-1.5 py-0.5 rounded text-[10px] bg-industrial-700 text-slate-300 font-mono">${escapeHtml(card.category)}</span>
            </div>
            <p class="text-slate-400 text-[11px] truncate mt-0.5">${escapeHtml(card.meaning)}</p>
          </div>
          <button onclick="deleteCustomCard(${idx})" class="p-1.5 text-slate-500 hover:text-rose-400 transition" title="Delete card">
            <i class="fa-solid fa-trash-can"></i>
          </button>
        </div>
      `).join('');
    }

    function exportDeckJSON() {
      if (localCustomCards.length === 0) {
        showToast("No custom cards to export", "warning");
        return;
      }
      const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(localCustomCards, null, 2));
      const downloadAnchor = document.createElement('a');
      downloadAnchor.setAttribute("href", dataStr);
      downloadAnchor.setAttribute("download", "my_flashcard_deck.json");
      document.body.appendChild(downloadAnchor);
      downloadAnchor.click();
      downloadAnchor.remove();
      showToast("Exported JSON deck!", "success");
    }

    function escapeHtml(str) {
      return (str || '').replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
    }

    // --- RENDER FLASHCARD LOGIC ---
    function renderCard() {
      if (!currentDeck || currentDeck.length === 0) {
        document.getElementById('cardFrontText').innerText = "No Cards Available";
        document.getElementById('cardFrontSubtext').innerText = "Please add cards in Settings.";
        document.getElementById('totalCardsCount').innerText = "0";
        document.getElementById('currentCardIndex').innerText = "0";
        return;
      }

      const card = currentDeck[currentIndex];
      const frontCategory = document.getElementById('frontCategoryBadge');
      const backCategory = document.getElementById('backCategoryBadge');
      const frontText = document.getElementById('cardFrontText');
      const frontSubtext = document.getElementById('cardFrontSubtext');
      const backTitle = document.getElementById('cardBackTitle');
      const backDescription = document.getElementById('cardBackDescription');
      const backExtra = document.getElementById('cardBackExtra');

      // Category update
      frontCategory.innerText = card.category || 'General';
      backCategory.innerText = (card.category || 'General') + ' • ANSWER';

      // Mode-based display logic
      if (studyMode === 'term-first') {
        frontText.innerText = card.word;
        frontSubtext.innerText = "Recite the definition & characteristics";
        frontSubtext.classList.remove('hidden');

        backTitle.innerText = card.word;
        backDescription.innerText = card.meaning;
      } else {
        // Definition first mode
        frontText.innerText = card.meaning;
        frontSubtext.innerText = "Identify the term / concept name";
        frontSubtext.classList.remove('hidden');

        backTitle.innerText = card.word;
        backDescription.innerText = "Definition: " + card.meaning;
      }

      // Extra Characteristics / Data block
      if (card.extra && card.extra.trim() !== "") {
        backExtra.innerText = card.extra;
        backExtra.classList.remove('hidden');
      } else {
        backExtra.classList.add('hidden');
      }

      // Reset Card Flip State
      resetFlipState();

      // Update counters & progress bar
      document.getElementById('currentCardIndex').innerText = currentIndex + 1;
      document.getElementById('totalCardsCount').innerText = currentDeck.length;
      
      const progressPercent = ((currentIndex + 1) / currentDeck.length) * 100;
      document.getElementById('progressBar').style.width = progressPercent + '%';
    }

    // --- CARD FLIP LOGIC ---
    function flipCard() {
      const cardEl = document.getElementById('flashcard');
      isFlipped = !isFlipped;
      if (isFlipped) {
        cardEl.classList.add('rotate-y-180');
      } else {
        cardEl.classList.remove('rotate-y-180');
      }
    }

    function resetFlipState() {
      isFlipped = false;
      document.getElementById('flashcard').classList.remove('rotate-y-180');
    }

    // --- DECK NAVIGATION ---
    function nextCard() {
      if (currentDeck.length === 0) return;
      currentIndex = (currentIndex + 1) % currentDeck.length;
      renderCard();
    }

    function prevCard() {
      if (currentDeck.length === 0) return;
      currentIndex = (currentIndex - 1 + currentDeck.length) % currentDeck.length;
      renderCard();
    }

    function shuffleDeck() {
      if (currentDeck.length <= 1) return;
      
      // Fisher-Yates shuffle
      for (let i = currentDeck.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [currentDeck[i], currentDeck[j]] = [currentDeck[j], currentDeck[i]];
      }
      
      currentIndex = 0;
      renderCard();
      showToast("Deck shuffled successfully!");
    }

    // --- MODE SWITCHING ---
    function setStudyMode(mode) {
      studyMode = mode;
      const termBtn = document.getElementById('modeTermFirstBtn');
      const defBtn = document.getElementById('modeDefFirstBtn');

      if (mode === 'term-first') {
        termBtn.className = "flex-1 md:flex-none px-3 py-1.5 rounded-md text-xs font-medium transition duration-150 bg-industrial-accent text-white shadow";
        defBtn.className = "flex-1 md:flex-none px-3 py-1.5 rounded-md text-xs font-medium transition duration-150 text-slate-400 hover:text-slate-200";
      } else {
        defBtn.className = "flex-1 md:flex-none px-3 py-1.5 rounded-md text-xs font-medium transition duration-150 bg-industrial-accent text-white shadow";
        termBtn.className = "flex-1 md:flex-none px-3 py-1.5 rounded-md text-xs font-medium transition duration-150 text-slate-400 hover:text-slate-200";
      }

      renderCard();
    }

    // --- SELF ASSESSMENT TRACKING ---
    function recordScore(isCorrect) {
      if (isCorrect) {
        masteredCount++;
        document.getElementById('countMastered').innerText = masteredCount;
        showToast("Marked as Got it Right!", "success");
      } else {
        needsReviewCount++;
        document.getElementById('countNeedsReview').innerText = needsReviewCount;
        showToast("Marked for Review", "warning");
      }
      
      // Automatically advance to next card after scoring
      setTimeout(() => {
        nextCard();
      }, 250);
    }

    function resetStats() {
      masteredCount = 0;
      needsReviewCount = 0;
      document.getElementById('countMastered').innerText = "0";
      document.getElementById('countNeedsReview').innerText = "0";
      showToast("Session score reset");
    }

    // --- GOOGLE SHEETS / DATA FETCHING ---
    async function fetchDeckData() {
      const url = document.getElementById('scriptUrlInput').value.trim();
      const syncIcon = document.getElementById('syncIcon');

      if (!url) {
        showToast("No Apps Script URL configured. Opening settings...", "warning");
        openSettingsModal();
        return;
      }

      syncIcon.classList.add('fa-spin');
      showToast("Fetching cards from Google Sheets...");

      try {
        const response = await fetch(url);
        if (!response.ok) throw new Error("HTTP error! Status: " + response.status);
        
        const data = await response.json();
        
        if (Array.isArray(data) && data.length > 0) {
          currentDeck = data.map(item => ({
            word: item.word || item.Word || "Untitled",
            meaning: item.meaning || item.Meaning || item.definition || "No definition provided.",
            category: item.category || item.Category || "General",
            extra: item.extra || item.Extra || item.characteristics || item.Characteristics || ""
          }));

          currentIndex = 0;
          sourceType = 'sheet';
          document.getElementById('sourceLabel').innerText = "Google Sheets";
          document.getElementById('sourceIndicator').classList.remove('hidden');
          renderCard();
          showToast(`Successfully loaded ${currentDeck.length} flashcards!`, "success");
        } else {
          showToast("Sheet returned empty or invalid data format.", "warning");
        }
      } catch (err) {
        console.error("Sync Error:", err);
        showToast("Failed to fetch Google Sheet data. Check CORS / Web App URL permissions.", "danger");
      } finally {
        syncIcon.classList.remove('fa-spin');
      }
    }

    // --- LOCAL CSV PARSER ---
    function parseCSVData(csvText) {
      const lines = csvText.trim().split('\n');
      if (lines.length === 0) return [];

      const parsed = [];
      const startIndex = lines[0].toLowerCase().includes('word') ? 1 : 0; // detect header row

      for (let i = startIndex; i < lines.length; i++) {
        const row = lines[i].split(',').map(cell => cell.trim());
        if (row[0]) {
          parsed.push({
            word: row[0],
            meaning: row[1] || "No definition",
            category: row[2] || "General",
            extra: row[3] || ""
          });
        }
      }
      return parsed;
    }

    // --- KEYBOARD CONTROLS ---
    function handleKeyPress(e) {
      // Prevent shortcut interference when typing inside text inputs
      if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;

      switch (e.code) {
        case 'Space':
          e.preventDefault();
          flipCard();
          break;
        case 'ArrowRight':
          nextCard();
          break;
        case 'ArrowLeft':
          prevCard();
          break;
        case 'Digit1':
        case 'KeyN':
          recordScore(false);
          break;
        case 'Digit2':
        case 'KeyY':
          recordScore(true);
          break;
      }
    }

    // --- MODAL & SETTINGS MANAGEMENT ---
    function openSettingsModal() {
      document.getElementById('settingsModal').classList.remove('hidden');
    }

    function closeSettingsModal() {
      document.getElementById('settingsModal').classList.add('hidden');
    }

    function openScriptGuideModal() {
      document.getElementById('scriptGuideModal').classList.remove('hidden');
    }

    function closeScriptGuideModal() {
      document.getElementById('scriptGuideModal').classList.add('hidden');
    }

    function setSourceType(type) {
      sourceType = type;
      const sheetBtn = document.getElementById('srcTypeSheet');
      const csvBtn = document.getElementById('srcTypeCsv');
      const sheetSec = document.getElementById('sheetConfigSection');
      const localSec = document.getElementById('localConfigSection');

      if (type === 'sheet') {
        sheetBtn.className = "p-3 border rounded-xl text-left font-semibold text-xs flex items-center gap-3 bg-industrial-700 border-industrial-accent text-white";
        csvBtn.className = "p-3 border rounded-xl text-left font-semibold text-xs flex items-center gap-3 bg-industrial-900 border-industrial-700 text-slate-400";
        sheetSec.classList.remove('hidden');
        localSec.classList.add('hidden');
      } else {
        csvBtn.className = "p-3 border rounded-xl text-left font-semibold text-xs flex items-center gap-3 bg-industrial-700 border-industrial-accent text-white";
        sheetBtn.className = "p-3 border rounded-xl text-left font-semibold text-xs flex items-center gap-3 bg-industrial-900 border-industrial-700 text-slate-400";
        localSec.classList.remove('hidden');
        sheetSec.classList.add('hidden');
      }
    }

    function saveSettings() {
      const urlInput = document.getElementById('scriptUrlInput').value.trim();
      const csvInput = document.getElementById('csvTextInput').value.trim();

      if (urlInput) {
        localStorage.setItem('reviewer_script_url', urlInput);
        scriptUrl = urlInput;
      }

      if (sourceType === 'local' && csvInput) {
        const localCards = parseCSVData(csvInput);
        if (localCards.length > 0) {
          currentDeck = localCards;
          currentIndex = 0;
          document.getElementById('sourceLabel').innerText = "Local CSV";
          document.getElementById('sourceIndicator').classList.remove('hidden');
          renderCard();
          showToast(`Loaded ${localCards.length} cards from local data!`, "success");
        } else {
          showToast("Could not parse local data.", "warning");
        }
      } else if (sourceType === 'sheet' && urlInput) {
        fetchDeckData();
      }

      closeSettingsModal();
    }

    function copyAppsScriptCode() {
      const code = `function doGet() {
  var sheet = SpreadsheetApp.getActiveSpreadsheet().getActiveSheet();
  var data = sheet.getDataRange().getValues();
  var result = [];

  for (var i = 1; i < data.length; i++) {
    var row = data[i];
    if (row[0]) {
      result.push({
        word: row[0],
        meaning: row[1] || "",
        category: row[2] || "General",
        extra: row[3] || ""
      });
    }
  }

  return ContentService.createTextOutput(JSON.stringify(result))
    .setMimeType(ContentService.MimeType.JSON);
}`;

      const tempTextArea = document.createElement("textarea");
      tempTextArea.value = code;
      document.body.appendChild(tempTextArea);
      tempTextArea.select();
      document.execCommand("copy");
      document.body.removeChild(tempTextArea);
      showToast("Google Apps Script snippet copied to clipboard!", "success");
    }

    // --- TOAST NOTIFICATIONS ---
    function showToast(message, type = 'info') {
      const toast = document.getElementById('toast');
      const toastMsg = document.getElementById('toastMessage');
      const toastIcon = document.getElementById('toastIcon');

      toastMsg.innerText = message;

      if (type === 'success') {
        toastIcon.className = "fa-solid fa-circle-check text-emerald-400";
      } else if (type === 'warning') {
        toastIcon.className = "fa-solid fa-triangle-exclamation text-amber-400";
      } else if (type === 'danger') {
        toastIcon.className = "fa-solid fa-circle-xmark text-rose-400";
      } else {
        toastIcon.className = "fa-solid fa-circle-info text-industrial-accent";
      }

      toast.classList.remove('translate-y-20', 'opacity-0');
      toast.classList.add('translate-y-0', 'opacity-100');

      setTimeout(() => {
        toast.classList.remove('translate-y-0', 'opacity-100');
        toast.classList.add('translate-y-20', 'opacity-0');
      }, 3000);
    }
  </script>
