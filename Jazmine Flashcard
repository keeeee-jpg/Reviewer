          <button onclick="copyAppsScriptCode()" class="absolute top-3 right-3 px-2.5 py-1 rounded bg-industrial-700 hover:bg-industrial-600 text-slate-200 text-[10px] font-mono border border-industrial-600 transition flex items-center gap-1">
